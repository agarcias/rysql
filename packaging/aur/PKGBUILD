# Maintainer: RySQL contributors
pkgname=rysql
pkgver=0.6.0
pkgrel=1
pkgdesc='GUI client for MySQL and MariaDB (egui + sqlx)'
arch=('x86_64')
url='https://github.com/arongarcia/rysql'
license=('MIT' 'Apache-2.0')
depends=(
    'gcc-libs'
    'glibc'
    'libxkbcommon'
    'wayland'
    'libxcb'
    'mesa'
    'fontconfig'
    'dbus'
)
makedepends=('cargo' 'pkgconf' 'clang')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "${CARCH}-unknown-linux-gnu"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --release --frozen --bin rysql
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --release --frozen --workspace --no-fail-fast
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 'target/release/rysql' "$pkgdir/usr/bin/rysql"
    install -Dm644 'packaging/linux/rysql.desktop' \
        "$pkgdir/usr/share/applications/rysql.desktop"
    install -Dm644 'packaging/linux/rysql.svg' \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/rysql.svg"
    install -Dm644 'packaging/linux/io.rysql.RySQL.metainfo.xml' \
        "$pkgdir/usr/share/metainfo/io.rysql.RySQL.metainfo.xml"
    install -Dm644 'LICENSE-MIT' "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
    install -Dm644 'LICENSE-APACHE' "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
